{
  "name": "KM",
  "short_name": "KM",
  "description": "KM - Tic Tac Toe and mutual-follow inbox messaging.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#030712",
