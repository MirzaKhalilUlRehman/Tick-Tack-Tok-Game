rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Profiles, Social Follow Relationships & Activity
    match /users/{userId} {
      allow read, write: if true;
    }

    // Mutual-Follow Permanent Conversations, Messages & Reactions
    match /conversations/{convId} {
      allow read, write: if true;
    }

    // 2-Player Private Pairing & Match Sessions
    match /privatePairs/{pairId} {
      allow read, write: if true;
    }

    // Synchronized Tic Tac Toe Games
    match /games/{pairId} {
      allow read, write: if true;
    }

    // Permanent Head-to-Head Player Relationships
    match /playerRelationships/{relId} {
      allow read, write: if true;
    }

    match /matches/{matchId} {
      allow read, write: if true;
    }

    match /rooms/{roomId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

